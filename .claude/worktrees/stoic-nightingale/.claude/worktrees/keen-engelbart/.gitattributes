# Force LF line endings for all Python/text files
* text=auto eol=lf
*.py text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.md text eol=lf
*.env text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary files - no line ending conversion
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pkl binary
*.joblib binary
*.h5 binary
