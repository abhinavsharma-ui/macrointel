# ══════════════════════════════════════════════════════════════
# Precision Target Configuration
# For 70% directional accuracy with real money trading
# ══════════════════════════════════════════════════════════════

# Target precision (must be >= 70% for live trading)
TARGET_PRECISION=0.70

# Confidence thresholds for trade execution
BUY_CONFIDENCE_THRESHOLD=0.60
SELL_CONFIDENCE_THRESHOLD=0.60
MIN_CONFIDENCE_FOR_TRADE=0.55

# High confidence for precision targeting
HIGH_CONFIDENCE=0.65
VERY_HIGH_CONFIDENCE=0.75

# Ensemble calibration
ENSEMBLE_TEMPERATURE=1.2
DYNAMIC_WEIGHT_RECALIBRATION_DAYS=5

# XGBoost parameters enhanced for 70% precision
XGB_N_ESTIMATORS=1500
XGB_MAX_DEPTH=7
XGB_LEARNING_RATE=0.008
XGB_SUBSAMPLE=0.70
XGB_REG_ALPHA=0.20
XGB_REG_LAMBDA=2.0

# LSTM training
LSTM_HIDDEN_SIZE=256
LSTM_NUM_LAYERS=3
LSTM_DROPOUT=0.2
LSTM_USE_FOCAL_LOSS=true
LSTM_MAX_EPOCHS=100
LSTM_PATIENCE=12

# Transformer 
TRANSFORMER_D_MODEL=128
TRANSFORMER_NHEAD=4
TRANSFORMER_NUM_LAYERS=3

# Walk-forward validation
WALK_FORWARD_N_SPLITS=5
WALK_FORWARD_MIN_TRAIN_DAYS=252

# Risk management
MAX_POSITION_SIZE=0.10
MAX_SECTOR_EXPOSURE=0.25
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=5.0

# Regime-based position sizing
REGIME_CRISIS_POSITION=0.10
REGIME_STRESSED_POSITION=0.30
REGIME_NORMAL_POSITION=0.60
REGIME_CALM_POSITION=0.80