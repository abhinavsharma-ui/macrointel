EARNINGS_PROPAGATION_FAST_WINDOW_DAYS=3
EARNINGS_PROPAGATION_WINDOW_DAYS=7
EVENT_PROXY_FALLBACK_ENABLED=1
EVENT_PROXY_GAP_THRESHOLD=0.04
EVENT_PROXY_VOLUME_Z_THRESHOLD=2.0
EVENT_PROXY_MAX_EVENTS_PER_SYMBOL=2
INFERENCE_REFRESH_SECONDS=60
DASHBOARD_PUSH_INTERVAL_SECONDS=2.0
