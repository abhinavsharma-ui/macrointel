# â”€â”€ Remote Access (Ngrok) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Free account at https://ngrok.com gives you persistent URLs
# Get your authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
# Leave blank for random URL (changes each session)
NGROK_AUTH_TOKEN=

# â”€â”€ Dashboard â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
DASHBOARD_PORT=5050

# â”€â”€ Performance (Keep Full Universe/Data) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# These reduce lag/overheating WITHOUT reducing symbol count or price history.
PERF_PROFILE=balanced
MAX_CPU_THREADS=4
PERF_SET_PROCESS_PRIORITY=1
PROCESS_PRIORITY=below_normal

# Optional cap for testing only (0 = no cap)
UNIVERSE_LIMIT=0

# Polling fallback controls (only used for symbols not covered by WebSockets)
POLLING_FALLBACK_ENABLED=1
POLL_INTERVAL_SECONDS=15
POLL_BATCH_SIZE=20

# Keep full history on disk without storing all of it in RAM
PRICE_FETCH_FULL_HISTORY=1
PRICE_FULL_FETCH_ONCE=1
PRICE_KEEP_FULL_HISTORY=0
PRICE_STORE_FULL_HISTORY=1
PRICE_STORE_FULL_DIR=data/prices_full

# Feature engineering speed-ups (does not delete history; only limits how many rows are processed per loop)
FEATURE_ENGINEERING_TAIL_ROWS=600
EVENT_REVERSAL_TAIL_ROWS=80

# Optional: cut feature RAM roughly in half (float32). Leave blank for float64.
FEATURE_FLOAT_DTYPE=float32

# Runtime switches (dashboard/realtime on; optional camera/backtests off by default)
RUN_DASHBOARD=1
RUN_REALTIME=1
RUN_BACKTEST=0
RUN_SECURITY=0

# â”€â”€ Camera â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Camera device index (0 = default webcam, 1 = second camera, etc.)
CAMERA_INDEX=0

