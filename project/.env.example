# MacroIntel current public environment template
# Copy this file to project/.env and fill private values locally.
# Do not commit project/.env.

# Dashboard
DASHBOARD_ULTRA_PORT=5055
PORT=5055
DASHBOARD_US_INITIAL_CAPITAL=100000
PAPER_CAPITAL=100000
ALLOWED_DASHBOARD_HOSTS=*

# Runtime posture
BROKER_EXECUTION_MODE=paper
ALPACA_PAPER=true
RUN_BACKTEST=0
RUN_SECURITY=0

# Alpaca paper integration
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# LLM / OpenRouter-compatible key pool
# Use comma-separated keys. Keep real keys only in project/.env.
GROQ_API_KEY=
GROQ_MODEL=nvidia/nemotron-3-super-120b-a12b:free
GROQ_BASE_URL=https://openrouter.ai/api/v1/chat/completions
LLM_RESERVE_LAST_KEY_FOR_SEARCH=0
LLM_SEARCH_USE_ALL_KEYS=1
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_TOTAL_TIMEOUT_SECONDS=0
LLM_MAX_ROUNDS=14

# US fixed-return signal generation
SIG_LIVE_ROOT=data/features
SIG_THRESHOLD=0.61
SIG_TOP_N=50
SIG_MIN_PRICE=5
SIG_MIN_ADV20_DOLLAR_VOL=5000000
SIG_EXPANDED_UNIVERSE_CAP=1500
SIG_PROFIT_TARGET_PCT=8
SIG_STOP_LOSS_PCT=0
SIG_HOLD_DAYS=12
SIG_POSITION_PCT=0.03
SIG_FIXED_POSITION_SIZE=1
SIG_USE_VOL_SCALING=0
SIG_MAX_BIOTECH_PER_DAY=999
SIG_FACTOR_OVERLAY_ENABLED=1
SIG_FACTOR_OVERLAY_WEIGHT=0.03
SIG_FACTOR_TIE_BAND=0.012
OPTIONS_DIAG_CACHE_HOURS=12

# US fixed-return state files
FR_SIGNALS_PATH=reports/fixed_return_daily_signals.json
FR_POSITIONS_PATH=reports/fixed_return_open_positions.json
FR_TRADES_CSV=reports/fixed_return_paper_trades.csv
FR_MAX_OPEN_POSITIONS=50

# Stock diagnostic
SYMBOL_DIAG_REPORT=reports/symbol_diagnostics.json
SYMBOL_DIAG_MIN_FEATURE_ROWS=260
SYMBOL_DIAG_HISTORY_DAYS=950
SYMBOL_DIAG_LLM_MODE=precomputed_production_tools
SYMBOL_DIAG_LLM_HARD_TIMEOUT_SECONDS=125

# Intraday mark-to-market
INTRADAY_MTM_INTERVAL=30m
INTRADAY_MTM_MARKET_HOURS_ONLY=1

# Intelligent stop-loss verification
SL_VERIFY_ENABLED=0
SL_VERIFY_SOFT_STOP_PCT=0
SL_VERIFY_HARD_KILL_PCT=7.0
SL_VERIFY_MAX_DAYS_BELOW=3
SL_VERIFY_MAX_HOLD_DAYS=10
SL_VERIFY_PLACE_BACKSTOP=1
SL_VERIFY_LLM_ENABLED=1

# Unified portfolio risk manager
RISK_MAX_GROSS_EXPOSURE_PCT=35
RISK_MAX_SECTOR_EXPOSURE_PCT=12
RISK_DAILY_LOSS_PAUSE_PCT=2.0
RISK_DRAWDOWN_YELLOW_PCT=5.0
RISK_DRAWDOWN_ORANGE_PCT=8.0
RISK_DRAWDOWN_RED_PCT=12.0

# Data refresh
PRICE_STORE_FULL_DIR=data/prices_full
FEATURE_ENGINEERING_TAIL_ROWS=600
FEATURE_FLOAT_DTYPE=float32

# Universe files
US_UNIVERSE_EXTRA_FILE=data/universe_us_official.txt
NSE_UNIVERSE_EXTRA_FILE=data/universe_nse_official.txt
OFFICIAL_US_UNIVERSE_FILE=data/universe_us_official.txt
OFFICIAL_NSE_UNIVERSE_FILE=data/universe_nse_official.txt

# Optional third-party data providers
FINNHUB_API_KEY=
FRED_API_KEY=
