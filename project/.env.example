ENABLE_CROSS_ASSET_REGIME_FACTOR=1
ENABLE_INSTITUTIONAL_FLOW_FACTOR=1
ENABLE_ORDER_BOOK_IMBALANCE_FACTOR=1
ENABLE_SUPPLY_CHAIN_PROPAGATION_FACTOR=1

# Walk-forward gate before loading meta_directional_models.joblib (reject weak reports).
# Loosen if retrain shows negative edge / low hit but you still want the new weights live.
# META_MODEL_GATE_MIN_PRECISION=0.15
# META_MODEL_GATE_MIN_COVERAGE_PCT=0.15
# META_MODEL_GATE_MIN_TAKEN_EDGE_PCT=-0.5
# META_MODEL_GATE_MIN_HIT_RATE_PCT=25
# Or skip the gate entirely (loads latest directional checkpoint anyway):
# META_MODEL_FORCE_LOAD_DIRECTIONAL=1

META_MODEL_RUNTIME_THRESHOLD=0.52
META_MODEL_RUNTIME_MIN_EDGE_PCT=0.18
META_MODEL_RUNTIME_MIN_EDGE_RATIO=0.08
META_MODEL_RUNTIME_MIN_CONVICTION=3.0
META_MODEL_RUNTIME_LEADER_MIN_CONVICTION=2.5
AUTO_RETRAIN_ON_START=1
AUTO_RETRAIN_TIMEOUT_SECONDS=1800
AUTO_RETRAIN_USE_OPTUNA=0
AUTO_RETRAIN_ONLY_IF_NEW_DATA=1
AUTO_RETRAIN_MIN_UPDATED_FILES=5
