EARNINGS_LOOKBACK_DAYS=45
EARNINGS_FORWARD_DAYS=7
EARNINGS_ALPHA_MAX_SYMBOLS=25
EODHD_EARNINGS_MAX_SYMBOLS=80
EARNINGS_PIPELINE_SYMBOL_CAP=1200
